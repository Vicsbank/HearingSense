# Swift 构建产物
app/.build/

# Hearing Sense iOS 2.0 (Window 1)
.pytest_cache/
data/emotify/audio_full/
# Xcode / SwiftPM per-user state and build output
xcuserdata/
*.xcuserstate
*.profraw
DerivedData/
packages/*/.build/
packages/*/.swiftpm/
packages/RuntimeDependencies/

# Version control setup (Window 2, before the first commit): keep all dataset content and audio
# out of Git. Re-download with tools/download_datasets.py (see data/README.md).
data/*
!data/README.md
!data/downloads/
data/downloads/*
!data/downloads/CHECKSUMS.json

# Window 2 offline evaluation: per-clip dumps are large and regenerable with hs-sound-eval;
# the summaries are kept.
results/sound_eval_window2/**/clips_*.jsonl

# Background-recognition research window: downloaded third-party models, code and converted
# packages are regenerable (tools/experiments/audio_models/README.md); not committed.
models/third_party/
models/coreml_audio/
results/background_benchmark/**/scores_*.npz
results/background_benchmark/**/apple_scores_*.jsonl
apps/ios/HearingSense/Experiments/Models/
